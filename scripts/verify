#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")/.." && pwd)"

(cd "$repo_dir/packages/backend" && mvn test)
(cd "$repo_dir/packages/extension" && ./node_modules/.bin/tsc --noEmit)
(cd "$repo_dir/packages/extension" && ./node_modules/.bin/vite build && node scripts/fix-sw.js)
if [[ "${SKIP_E2E:-0}" != "1" ]]; then
  (cd "$repo_dir/packages/extension" && ./node_modules/.bin/playwright test)
fi
(cd "$repo_dir/native-host" && PYTHONPYCACHEPREFIX=/private/tmp/omnistudy-pycache python3 -m unittest -v test_idea_bridge.py)
"$repo_dir/scripts/run-agent-evals"
