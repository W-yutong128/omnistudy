# Copy to a file outside Git, fill it in, then source it before deploying.
# Never commit the real values.
KUBE_CONTEXT=replace-with-production-context
OMNISTUDY_IMAGE=ghcr.io/replace-with-owner/omnistudy-backend:replace-with-git-sha
OMNISTUDY_API_HOST=api.example.com
OMNISTUDY_TLS_SECRET=omnistudy-api-tls
CORS_ALLOWED_ORIGINS=chrome-extension://replace-with-published-extension-id
# Optional when the GHCR package is private. The Secret must already exist in namespace omnistudy.
# IMAGE_PULL_SECRET=ghcr-pull-secret

DB_URL=jdbc:postgresql://replace-with-managed-postgresql-host:5432/omnistudy?sslmode=require
DB_USERNAME=omnistudy
DB_PASSWORD=replace-with-strong-database-password

REDIS_HOST=replace-with-managed-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-redis-password

# Generate independent values, for example: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
